# =========================================================================
# StockWise Environment Configuration Template
# Rename this file to '.env' and populate with your own production values
# =========================================================================

# Database Setup
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=inventory
POSTGRES_SERVER=db
POSTGRES_PORT=5432

# Backend CORS Configurations
# Set this to your live frontend domains in production (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost

# Frontend API Endpoint
# Points the React application to the backend REST API
VITE_API_URL=http://localhost:8000/api/v1
