# FastAPI Backend Environment Settings
# Rename to '.env' inside the backend/ folder

# Database configuration parameters
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inventory

# Alternatively, pass a fully qualified SQLAlchemy connection URL directly
# (Often automatically injected by production services like Render/Railway)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory

# Cross-Origin Resource Sharing (CORS) Settings
# Allow multiple frontend origin paths separated by commas
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
